{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "npx awesome-readme && npm run lint:fix && tsc --project tsconfig.json",
            "problemMatcher": []
        },
        {
            "label": "lint:fix",
            "type": "shell",
            "command": "prettier --write --no-error-on-unmatched-pattern src/**/*.{js,ts}",
            "problemMatcher": []
        },
        {
            "label": "lint",
            "type": "shell",
            "command": "prettier --check --no-error-on-unmatched-pattern src/**/*.{js,ts}",
            "problemMatcher": []
        },
        {
            "label": "watch",
            "type": "shell",
            "command": "tsc -w",
            "problemMatcher": []
        }
    ]
}
