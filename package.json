{
    "name": "slack-utility",
    "version": "0.1.33",
    "description": "Set of slack helper functions",
    "main": "dist/index",
    "typings": "dist/index",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "npx awesome-readme && npm run lint:fix && node node_modules/typescript/lib/tsc.js --project tsconfig.json",
        "lint:fix": "prettier --write src/**/*.{js,ts}",
        "lint": "prettier --check src/**/*.{js,ts}",
        "watch": "node node_modules/typescript/lib/tsc.js -w"
    },
    "files": [
        "/dist/**/*.{js,ts,map}",
        "/src/**/*.{js,ts}"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/marc-aurele-besner/slack-utility.git"
    },
    "keywords": [
        "slack",
        "slack-api",
        "helper",
        "utility"
    ],
    "author": "",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/marc-aurele-besner/slack-utility/issues"
    },
    "homepage": "https://github.com/marc-aurele-besner/slack-utility#readme",
    "dependencies": {
        "@slack/web-api": "^8.0.0",
        "ethers": "^6.0.0",
        "faunadb-utility": "^0.2.1",
        "mongoose": "^9.0.0",
        "uuid": "^11.0.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/uuid": "^11.0.0",
        "awesome-readme": "^0.0.8",
        "prettier": "^3.0.0",
        "ts-node": "^10.9.1",
        "tslint": "^6.1.3",
        "tslint-config-prettier": "^1.18.0",
        "tslint-plugin-prettier": "^2.3.0",
        "typescript": "^7.0.0"
    }
}
